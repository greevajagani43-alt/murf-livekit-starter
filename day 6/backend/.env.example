# =============================================================================
# Day 6 Backend — environment variables
# Copy this file to .env.local and fill in real values.
# =============================================================================

# -----------------------------------------------------------------------------
# LiveKit (real-time transport)
# Get from: https://cloud.livekit.io/ → your project → Settings
# -----------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# -----------------------------------------------------------------------------
# LiveKit SIP Trunk ID — REQUIRED for outbound calls
#
# Setup steps:
#   1. Go to https://cloud.livekit.io/ → SIP → Trunks → Create Outbound Trunk
#   2. Connect it to your Twilio SIP Domain (see README for Twilio setup)
#   3. Paste the Trunk ID here
# -----------------------------------------------------------------------------
LIVEKIT_SIP_TRUNK_ID=ST_your_sip_trunk_id_here

# -----------------------------------------------------------------------------
# Twilio — needed to CREATE the SIP trunk in Twilio console
# (the agent itself uses LiveKit SIP API; these are for reference/direct API use)
# Get from: https://console.twilio.com/
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# -----------------------------------------------------------------------------
# Murf (TTS — Text-to-Speech)
# Get from: https://murf.ai/api/dashboard
# -----------------------------------------------------------------------------
MURF_API_KEY=your_murf_api_key_here

# -----------------------------------------------------------------------------
# Deepgram (STT — Speech-to-Text)
# Get from: https://deepgram.com
# -----------------------------------------------------------------------------
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# -----------------------------------------------------------------------------
# Google Gemini (LLM)
# Get from: https://aistudio.google.com/apikey
# -----------------------------------------------------------------------------
GOOGLE_API_KEY=your_google_api_key_here
