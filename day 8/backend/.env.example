# =============================================================================
# Day 8 Backend Environment Variables Example
# Copy to .env.local and fill with real credentials
# =============================================================================

# LiveKit Credentials
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# LiveKit Outbound SIP Trunk ID
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=ST_Jq6TWCA78sef

# Murf Falcon TTS API Key
MURF_API_KEY=your_murf_api_key_here

# Deepgram STT API Key
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Google Gemini LLM API Key
GOOGLE_API_KEY=your_google_api_key_here
